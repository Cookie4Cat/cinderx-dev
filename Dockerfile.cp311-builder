# CinderX CPython 3.11 release-wheel builder (openEuler 24.03-LTS-SP3).
#
# Purpose-built for packaging, distinct from Dockerfile.cp311-dev: the
# compiler is the distro gcc-toolset-14 rpm instead of a source-built GCC,
# there is no debug or acceptance tooling, and the image rebuilds on any
# host in minutes.  The provenance switch away from the dev image was
# certified by running the full Lib/test differential gate against a wheel
# built here; docs/cp311-anchor.md records the evidence.
#
# Build:
#   docker build -f Dockerfile.cp311-builder -t cinderx-cp311-builder:v1 .

ARG PYTHON3_NVR=3.11.6-34.oe2403sp3

FROM openeuler/openeuler:24.03-lts-sp3

ARG PYTHON3_NVR

ENV LANG=en_US.UTF-8

# gcc-toolset-14-libstdc++-devel carries libstdc++.a: the release wheel
# links the C++ runtime statically so it runs on the stock image, whose
# system libstdc++ is a GCC 12 runtime.
RUN dnf install -y \
    gcc-toolset-14-gcc \
    gcc-toolset-14-gcc-c++ \
    gcc-toolset-14-libgcc \
    gcc-toolset-14-libstdc++-devel \
    make \
    cmake \
    binutils \
    findutils \
    git \
    zlib-devel \
    python3-${PYTHON3_NVR} \
    python3-devel-${PYTHON3_NVR} \
    python3-pip \
    && dnf clean all

# git fetches the CMake FetchContent dependencies (fmt and friends), which
# are pinned to immutable commit SHAs.  TLS verification stays ON by
# default; hosts behind TLS-intercepting intranet proxies opt down
# explicitly per build via CINDERX_GIT_INSECURE=1 (handled by the build
# script), instead of the image baking the downgrade in for everyone.

ENV PATH=/opt/openEuler/gcc-toolset-14/root/usr/bin:$PATH \
    CC=/opt/openEuler/gcc-toolset-14/root/usr/bin/gcc \
    CXX=/opt/openEuler/gcc-toolset-14/root/usr/bin/g++ \
    CINDERX_PYTHON3_NVR=${PYTHON3_NVR}

# Same pin as the dev image; recorded in docs/cp311-anchor.md.
RUN python3.11 -m pip install --no-cache-dir \
    -i https://mirrors.huaweicloud.com/repository/pypi/simple \
    "setuptools==80.9.0"

# Builder preflight, baked in and executed once at image build so a broken
# anchor can never produce an image at all.  The packaging flow runs it
# again before every build.
COPY ci_pipeline/scripts/check_cpython_311_build.sh /usr/local/bin/check-cpython-311-build
RUN chmod +x /usr/local/bin/check-cpython-311-build && check-cpython-311-build

WORKDIR /src

CMD ["/bin/bash"]
