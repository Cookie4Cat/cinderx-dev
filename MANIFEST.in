include CMakeLists.txt
include ci_pipeline/cmake_options.py
recursive-include cinderx *.cpp *.c *.h CMakeLists.txt
recursive-include cinderx/UpstreamBorrow *.template *.md *.txt *.html

# Opcode directories have invalid Python package names (e.g. opcodes/3.14) so
# they have to be included manually.
recursive-include cinderx/PythonLib/opcodes *.py

# The CPython 3.11 PGO trainer is run directly from an extracted source
# distribution before a wheel exists.
recursive-include cinderx/TestScripts *.py

# Required inputs for the CPython 3.11 build-directory patch series.
recursive-include cinderx/Interpreter/3.11/attr-patches *.cmake *.patch *.md
recursive-include tools/attr_path *.py *.c *.md
include cinderx/_cinderx.version
include cinderx/PythonLib/cinderx.pth
include cinderx/PythonLib/_cinderx_auto.py
